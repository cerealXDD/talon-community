list: user.code_formatter
-
#nope: NOOP
#void: NOOP
escape: BACKSLASH_SEPARATED
upper: ALL_CAPS
lower: ALL_LOWERCASE
topic: CAPITALIZE_ALL_WORDS
#cap: CAPITALIZE_ALL_WORDS
#capital: CAPITALIZE_ALL_WORDS
smash: NO_SPACES
#public: PUBLIC_CAMEL_CASE
#private: PRIVATE_CAMEL_CASE
camel: PRIVATE_CAMEL_CASE
peridot: DOT_SEPARATED
coma: COMMA_SEPARATED
trough: SINGLE_QUOTED_STRING
double trough: DOUBLE_QUOTED_STRING
dash: DASH_SEPARATED
#traffic: DOUBLE_COLON_SEPARATED
bark: SPACE_SURROUNDED_STRING
#absolute: ALL_SLASHES
#relative: SLASH_SEPARATED
underscore: SNAKE_CASE
#dunder: DOUBLE_UNDERSCORE
#constant: ALL_CAPS,SNAKE_CASE

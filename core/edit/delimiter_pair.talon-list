list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

twin thesis: ( )
twin block: [ ]
twin sharp: < >
twin nose: { }
twin trough: "' '"
twin quote: '" "'
twin critical: ` `
twin percent: % %
#twin bark: space space

twin escaped quote: '\\" \\"'
twin escaped trough:  "\\' \\'"
twin escaped thesis: \( \)
twin escaped block: \[ \]

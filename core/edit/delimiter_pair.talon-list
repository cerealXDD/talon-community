list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

twin theses: ( )
twin quart: [ ]
twin sharp: < >
twin front: { }
twin onus: "' '"
twin twice: '" "'
twin gravel: ` `
twin percent: % %
twin pace: space space

twin escaped twice: '\\" \\"'
twin escaped onus:  "\\' \\'"
twin escaped theses: \( \)
twin escaped quart: \[ \]

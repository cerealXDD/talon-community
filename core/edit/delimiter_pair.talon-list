list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

twin theses: ( )
twin quartz: [ ]
twin sharp: < >
twin front: { }
twin trough: "' '"
twin quote: '" "'
twin tickle: ` `
twin percent: % %
twin block: space space

twin escaped quote: '\\" \\"'
twin escaped trough:  "\\' \\'"
twin escaped theses: \( \)
twin escaped quartz: \[ \]

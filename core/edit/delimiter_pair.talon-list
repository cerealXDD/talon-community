list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

plurals thesis: ( )
plurals block: [ ]
plurals sharp: < >
plurals nose: { }
plurals trough: "' '"
plurals quote: '" "'
plurals critical: ` `
plurals percent: % %
#plurals bark: space space

plurals escaped quote: '\\" \\"'
plurals escaped trough:  "\\' \\'"
plurals escaped thesis: \( \)
plurals escaped block: \[ \]
